{
	"name": "Animated Route",
	"dockerComposeFile": "./docker-compose.yml",
	"service": "animated-route",
	"runServices": [],
	"workspaceFolder": "/app",
	"shutdownAction": "none",
	"remoteUser": "root",
	"features": {
		//  "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},
	"mounts": ["source=${localEnv:HOME}/.ssh,target=/root/.ssh,readonly,type=bind"],
	"customizations": {
		"vscode": {
			"extensions": ["angular.ng-template", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "ms-azuretools.vscode-docker"],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"typescript.tsdk": "node_modules/typescript/lib",
				"eslint.validate": ["javascript", "typescript", "html"],
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	},
	"postCreateCommand": "git config --global --add safe.directory /app"
}
